{
  "name": "turkish-inflect",
  "version": "0.1.0",
  "description": "Turkish suffixes for dynamic values in UI strings and i18n, following the TDK spelling guide.",
  "keywords": [
    "turkish",
    "turkce",
    "i18n",
    "l10n",
    "inflection",
    "morphology",
    "vowel-harmony",
    "suffix",
    "tdk",
    "number-to-words"
  ],
  "homepage": "https://github.com/aozmekik/turkish-inflect#readme",
  "bugs": {
    "url": "https://github.com/aozmekik/turkish-inflect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aozmekik/turkish-inflect.git"
  },
  "license": "MIT",
  "author": "Ahmed Semih Özmekik (https://github.com/aozmekik)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "node bench/inflect.ts",
    "size": "node scripts/size.ts",
    "examples": "node scripts/run-examples.ts",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check:tdk": "vitest run --config vitest.tdk.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run build && npm run check:package && npm run examples && npm run size"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "i18next": "^26.5.0",
    "intl-messageformat": "^12.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tinybench": "^6.2.2",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
